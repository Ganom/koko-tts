{
  "name": "koko-tts-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test -c playwright.config.dev.ts"
  },
  "dependencies": {
    "@lucide/lab": "^0.1.2",
    "@lucide/vue": "^1.11.0",
    "@vueuse/motion": "^3.0.3",
    "pinia": "^3.0.3",
    "pixi.js": "^8.19.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.21",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.0.4"
  }
}
